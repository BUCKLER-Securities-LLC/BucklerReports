        <Style />
      </Body>
      <Width>34.12948in</Width>
      <Page>
        <PageHeader>
          <Height>0.95708in</Height>
          <PrintOnFirstPage>true</PrintOnFirstPage>
          <PrintOnLastPage>true</PrintOnLastPage>
          <ReportItems>
            <Textbox Name="TextboxreportTitle">
              <CanGrow>true</CanGrow>
              <KeepTogether>true</KeepTogether>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>PNL Calculation</Value>
                      <Style>
                        <FontSize>18pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style>
                    <TextAlign>Center</TextAlign>
                  </Style>
                </Paragraph>
              </Paragraphs>
              <Left>13.98959in</Left>
              <Height>0.55173in</Height>
              <Width>6.15031in</Width>
              <Style>
                <Border>
                  <Style>None</Style>
                </Border>
                <PaddingLeft>2pt</PaddingLeft>
                <PaddingRight>2pt</PaddingRight>
                <PaddingTop>2pt</PaddingTop>
                <PaddingBottom>2pt</PaddingBottom>
              </Style>
            </Textbox>
            <Textbox Name="Textboxaddress">
              <CanGrow>true</CanGrow>
              <KeepTogether>true</KeepTogether>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>
												=
												iif(Parameters!Entity.Value="All","",
												First(Fields!Entity_Name.Value, "NameandAddress") + IIF(
												UCASE(Parameters!AccountNumber.Value) = "ALL" ,"" , " " ))
											</Value>
                      <Style>
                        <FontFamily>ARIAL</FontFamily>
                        <FontSize>7.5pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                      </Style>
                    </TextRun>
                    <TextRun>
                      <Value xml:space="preserve">
</Value>
                      <Style>
                        <FontFamily>ARIAL</FontFamily>
                        <FontSize>7.5pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                      </Style>
                    </TextRun>
                    <TextRun>
                      <Value>
												=iif(Parameters!Entity.Value="All","",First (Fields!FullAddress.Value,
												"NameandAddress"))
											</Value>
                      <Style>
                        <FontSize>7.5pt</FontSize>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style>
                    <TextAlign>Left</TextAlign>
                  </Style>
                </Paragraph>
              </Paragraphs>
              <Top>0.0191in</Top>
              <Left>0.86263in</Left>
              <Height>0.55173in</Height>
              <Width>1.29489in</Width>
              <ZIndex>1</ZIndex>
              <Style>
                <Border>
                  <Style>None</Style>
                </Border>
                <BackgroundColor>White</BackgroundColor>
                <VerticalAlign>Middle</VerticalAlign>
                <PaddingLeft>2pt</PaddingLeft>
                <PaddingRight>2pt</PaddingRight>
                <PaddingTop>2pt</PaddingTop>
                <PaddingBottom>2pt</PaddingBottom>
              </Style>
            </Textbox>
            <Image Name="Imagecompany">
              <Source>Database</Source>
              <Value>=First(Fields!EntityLogo.Value, "reportformat")</Value>
              <MIMEType>=First(Fields!MimeType.Value, "reportformat")</MIMEType>
              <Sizing>FitProportional</Sizing>
              <Top>0.0191in</Top>
              <Left>0.00152in</Left>
              <Height>0.55173in</Height>
              <Width>0.79167in</Width>
              <ZIndex>2</ZIndex>
              <Style>
                <Border>
                  <Style>None</Style>
                </Border>
              </Style>
            </Image>
            <Textbox Name="Textboxreportdate">
              <CanGrow>true</CanGrow>
              <KeepTogether>true</KeepTogether>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>
												="As Of Date: " +
												FormatDatetime(Parameters!SystemDate.Value,dateformat.ShortDate)
											</Value>
                      <Style>
                        <FontSize>7.5pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style>
                    <TextAlign>Right</TextAlign>
                  </Style>
                </Paragraph>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>
												="Entity: " + Parameters!Entity.Value
												+ ", Trader: " + Parameters!Trader.Value
											</Value>
                      <Style>
                        <FontSize>7.5pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style>
                    <TextAlign>Right</TextAlign>
                  </Style>
                </Paragraph>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>="Account Number: " + IIF(IsNothing(Parameters!AccountNumber.Value), "N/A", Parameters!AccountNumber.Value)</Value>
                      <Style>
                        <FontSize>7.5pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                      </Style>
                    </TextRun>
                    <TextRun>
                      <Value xml:space="preserve">
</Value>
                      <Style>
                        <FontSize>7.5pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                      </Style>
                    </TextRun>
                    <TextRun>
