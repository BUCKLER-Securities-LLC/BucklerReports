										<TablixCell>
											<CellContents>
												<Textbox Name="ExtRef14">
													<CanGrow>true</CanGrow>
													<KeepTogether>true</KeepTogether>
													<Paragraphs>
														<Paragraph>
															<TextRuns>
																<TextRun>
																	<Value>=Fields!CUSIP.Value</Value>
																	<Style>
																		<FontFamily>=First(Fields!RowFont.Value, "reportformat")</FontFamily>
																		<Color>=First(Fields!RowForeCol.Value, "reportformat")</Color>
																	</Style>
																</TextRun>
															</TextRuns>
															<Style>
																<TextAlign>Center</TextAlign>
															</Style>
														</Paragraph>
													</Paragraphs>
													<rd:DefaultName>ExtRef</rd:DefaultName>
													<Style>
														<Border>
															<Color>LightGrey</Color>
															<Style>Solid</Style>
														</Border>
														<BackgroundColor>
															=IIF(RowNumber(Nothing) Mod 2 = 0,
															First(Fields!AltRowBackCol.Value, "reportformat"), First(Fields!RowBackCol.Value,
															"reportformat"))
														</BackgroundColor>
														<PaddingLeft>2pt</PaddingLeft>
														<PaddingRight>2pt</PaddingRight>
														<PaddingTop>2pt</PaddingTop>
														<PaddingBottom>2pt</PaddingBottom>
													</Style>
												</Textbox>
											</CellContents>
										</TablixCell>
										<TablixCell>
											<CellContents>
												<Textbox Name="ExtRef15">
													<CanGrow>true</CanGrow>
													<KeepTogether>true</KeepTogether>
													<Paragraphs>
														<Paragraph>
															<TextRuns>
																<TextRun>
																	<Value>=Sum(IIf(Fields!TradeDate.Value = "CLOSING", CDec(IIf(IsNothing(Fields!Quantity.Value), 0, Fields!Quantity.Value)), CDec(0)))</Value>
																	<Style>
																		<FontFamily>=First(Fields!RowFont.Value, "reportformat")</FontFamily>
																		<Format>#,0.00;(#,0.00)</Format>
																		<Color>=First(Fields!RowForeCol.Value, "reportformat")</Color>
																	</Style>
																</TextRun>
															</TextRuns>
															<Style>
																<TextAlign>Right</TextAlign>
															</Style>
														</Paragraph>
													</Paragraphs>
													<rd:DefaultName>ExtRef</rd:DefaultName>
													<Style>
														<Border>
															<Color>LightGrey</Color>
															<Style>Solid</Style>
														</Border>
														<BackgroundColor>
															=IIF(RowNumber(Nothing) Mod 2 = 0,
															First(Fields!AltRowBackCol.Value, "reportformat"), First(Fields!RowBackCol.Value,
															"reportformat"))
														</BackgroundColor>
														<PaddingLeft>2pt</PaddingLeft>
														<PaddingRight>2pt</PaddingRight>
														<PaddingTop>2pt</PaddingTop>
														<PaddingBottom>2pt</PaddingBottom>
													</Style>
												</Textbox>
											</CellContents>
										</TablixCell>
										<TablixCell>
											<CellContents>
												<Textbox Name="ExtRef22">
													<CanGrow>true</CanGrow>
													<KeepTogether>true</KeepTogether>
													<Paragraphs>
														<Paragraph>
															<TextRuns>
																<TextRun>
																	<Value>=Sum(System.Math.abs(Fields!MTDInterest.Value))</Value>
																	<Style>
																		<FontFamily>=First(Fields!RowFont.Value, "reportformat")</FontFamily>
																		<Format>#,0.00;(#,0.00)</Format>
																		<Color>=First(Fields!RowForeCol.Value, "reportformat")</Color>
																	</Style>
																</TextRun>
